# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Local PostgreSQL. Create the database first: CREATE DATABASE getpoint;
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/getpoint?schema=public

# Comma-separated origins allowed to call the API (CMS + LIFF dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Auth ----
# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL_MINUTES=15
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Public CMS URL (used in password-reset emails)
CMS_URL=http://localhost:5173

# ---- Email (optional) ----
# Leave SMTP_HOST empty in development: reset emails are printed in the API console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GET POINT <no-reply@getpoint.local>

# ---- LOGA (points system) ----
# mock = built-in fake LOGA for development (no credentials needed)
# live = the real LOGA API (needs the three values below)
LOGA_MODE=mock
LOGA_BASE_URL=https://loga.app/api
# LOGA Merchant login (usually the email) and its password (plain; the API hashes it for LOGA)
LOGA_USERNAME=
LOGA_PASSWORD=
# Any fixed name for this server; the LOGA login token is tied to it
LOGA_DEVICE_ID=GETPOINT-API
# One LOGA card for all of GET POINT (Card ID from LOGA Merchant > Manage > Card info).
# TEMPORARY: this is the developer's own test card for now.
# Change it to the real GET POINT card before going live.
LOGA_CARD_ID=
LOGA_TIMEOUT_MS=10000

# ---- Seed (npm run db:seed) ----
# First admin account. Password: 8+ characters. Change it after first login.
SEED_ADMIN_EMAIL=admin@getpoint.local
SEED_ADMIN_PASSWORD=CHANGE_ME

# Folder for uploaded receipt files (git-ignored). Relative to apps/api, or an absolute path.
RECEIPT_STORAGE_DIR=storage/receipts

# ---- LINE (member app / LIFF) ----
# mock = development login without LINE (the member app shows a "test login" form).
#        Not allowed when NODE_ENV=production.
# live = real LINE: needs the LINE Login channel ID and the LIFF ID from LINE Developers.
LINE_MODE=mock
LINE_CHANNEL_ID=
LIFF_ID=
LIFF_SESSION_MINUTES=120

# ---- SMS (phone codes; only used when "verify phone by SMS" is switched on in Settings) ----
# mock = the code is printed in the API console (development only). Real providers come later.
SMS_PROVIDER=mock

# Number of reverse proxies in front of the API (1 behind nginx / a load balancer; 0 = direct).
# Needed for the real client IP in rate limits and the Activity Log.
TRUST_PROXY=0
