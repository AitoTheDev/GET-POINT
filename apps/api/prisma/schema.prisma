// GET POINT CMS database schema.
// Models are added session by session. Table names are snake_case plural.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// ---------- Organisation: Community -> Location -> Shop ----------
// Codes (COM001, LOC001, S001) are generated by the database from sequences, so they are
// unique even when two people create records at the same moment (see gp_next_code()).

model Community {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @default(dbgenerated("gp_next_code('COM'::text, 'community_code_seq'::regclass)"))
  name      String
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  locations  Location[]
  userScopes UserScope[]
  members    Member[]
  pointRules PointRule[]

  @@map("communities")
}

/// A Community Mall (สถานที่), e.g. LOC001 Community Mall A.
model Location {
  id          String       @id @default(uuid()) @db.Uuid
  communityId String       @map("community_id") @db.Uuid
  code        String       @unique @default(dbgenerated("gp_next_code('LOC'::text, 'location_code_seq'::regclass)"))
  name        String
  province    String?
  status      ActiveStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  community  Community   @relation(fields: [communityId], references: [id])
  userScopes UserScope[]
  shops      Shop[]
  pointRules PointRule[]
  receipts   Receipt[]

  @@index([communityId])
  @@map("locations")
}

/// Shop category (หมวดหมู่), e.g. คาเฟ่, อาหาร. Managed by admins.
model ShopCategory {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  sortOrder Int          @default(0) @map("sort_order")
  status    ActiveStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  shops Shop[]

  @@map("shop_categories")
}

model Shop {
  id            String       @id @default(uuid()) @db.Uuid
  locationId    String       @map("location_id") @db.Uuid
  categoryId    String?      @map("category_id") @db.Uuid
  code          String       @unique @default(dbgenerated("gp_next_code('S'::text, 'shop_code_seq'::regclass)"))
  name          String
  /// Name as printed on receipts (ชื่อร้านบนใบเสร็จ); used to match shops when OCR is added.
  receiptName   String?      @map("receipt_name")
  /// ร่วมสะสมแต้ม: receipts from this shop can earn points.
  participating Boolean      @default(true)
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  location   Location      @relation(fields: [locationId], references: [id])
  category   ShopCategory? @relation(fields: [categoryId], references: [id])
  pointRules PointRule[]
  receipts   Receipt[]

  @@index([locationId])
  @@index([categoryId])
  @@map("shops")
}

// ---------- Members ----------

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum MemberChannel {
  CMS
  LINE
}

enum LogaLinkStatus {
  NOT_LINKED
  LINKED
  ERROR
}

/// A shopper who collects points. Points balance, level and birthday live in LOGA (read live).
model Member {
  id          String        @id @default(uuid()) @db.Uuid
  communityId String        @map("community_id") @db.Uuid
  code        String        @unique @default(dbgenerated("gp_next_code('M'::text, 'member_code_seq'::regclass, 4)"))
  /// Thai mobile, stored as 10 digits ("0812345678"). Used to find the member in LOGA.
  phone       String
  firstName   String        @map("first_name")
  lastName    String?       @map("last_name")
  status      MemberStatus  @default(ACTIVE)
  channel     MemberChannel @default(CMS)
  /// LINE user ID, set when the member links through LIFF.
  lineUserId  String?       @unique @map("line_user_id")
  /// Internal staff note; never shown to the member.
  note        String?
  createdById String?       @map("created_by_id") @db.Uuid

  /// LOGA member ID for LINE/app members (data.card.uid).
  logaUid        String?        @map("loga_uid")
  /// LOGA member ID for members created by us or with a plastic card (data.card.pcard_id).
  logaPcardId    String?        @map("loga_pcard_id")
  logaLinkStatus LogaLinkStatus @default(NOT_LINKED) @map("loga_link_status")
  /// Last linking error shown to staff (no secrets).
  logaLinkError  String?        @map("loga_link_error")
  logaCheckedAt  DateTime?      @map("loga_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community    Community          @relation(fields: [communityId], references: [id])
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submissions  Submission[]
  receipts     Receipt[]
  transactions PointTransaction[]

  @@unique([communityId, phone])
  @@index([createdAt])
  @@index([status])
  @@map("members")
}

// ---------- Point rules ----------

enum RoundingMode {
  FLOOR
  ROUND
  CEIL
}

/// "X baht = Y points" set on exactly one of: a Community, a Location or a Shop.
/// A receipt uses the Shop's rule, else its Location's, else its Community's, picked by the
/// receipt date. Rules at the same place may not have overlapping active date ranges.
model PointRule {
  id          String       @id @default(uuid()) @db.Uuid
  communityId String?      @map("community_id") @db.Uuid
  locationId  String?      @map("location_id") @db.Uuid
  shopId      String?      @map("shop_id") @db.Uuid
  spendAmount Decimal      @map("spend_amount") @db.Decimal(12, 2)
  points      Int
  rounding    RoundingMode @default(FLOOR)
  /// Optional cap per receipt.
  maxPoints   Int?         @map("max_points")
  /// Receipts must be sent within this many days of the receipt date; null = no limit.
  claimDays   Int?         @default(30) @map("claim_days")
  /// Calendar days (Bangkok), compared with the date printed on the receipt.
  startDate   DateTime     @map("start_date") @db.Date
  /// null = no end date.
  endDate     DateTime?    @map("end_date") @db.Date
  status      ActiveStatus @default(ACTIVE)
  /// Increases on every change; each version is kept in point_rule_versions.
  version     Int          @default(1)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  community    Community?         @relation(fields: [communityId], references: [id], onDelete: Restrict)
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shop         Shop?              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions     PointRuleVersion[]
  transactions PointTransaction[]

  @@index([communityId])
  @@index([locationId])
  @@index([shopId])
  @@map("point_rules")
}

/// Every saved version of a rule, so the exact formula used for a past receipt can be shown.
model PointRuleVersion {
  id          String       @id @default(uuid()) @db.Uuid
  ruleId      String       @map("rule_id") @db.Uuid
  version     Int
  spendAmount Decimal      @map("spend_amount") @db.Decimal(12, 2)
  points      Int
  rounding    RoundingMode
  maxPoints   Int?         @map("max_points")
  claimDays   Int?         @map("claim_days")
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  status      ActiveStatus
  changedById String?      @map("changed_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  rule      PointRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  changedBy User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([ruleId, version])
  @@map("point_rule_versions")
}

// ---------- Receipts ----------

enum ReceiptStatus {
  PENDING_REVIEW
  NEEDS_CHECK
  APPROVED
  REJECTED
}

enum RejectReason {
  UNREADABLE
  DUPLICATE
  SHOP_NOT_PARTICIPATING
  NOT_A_RECEIPT
  INCOMPLETE
  TOO_OLD
  SHOP_NOT_FOUND
  ALTERED
  OTHER
}

enum SubmissionChannel {
  LIFF
  /// Added by staff on the review page.
  CMS
  /// Created by the development sample script.
  SAMPLE
}

enum TransferStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
}

/// One send from a member: up to 10 files, each becoming one Receipt.
model Submission {
  id          String            @id @default(uuid()) @db.Uuid
  memberId    String            @map("member_id") @db.Uuid
  channel     SubmissionChannel @default(LIFF)
  /// Staff member who added it (channel CMS).
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  receipts  Receipt[]

  @@index([memberId])
  @@map("submissions")
}

/// One receipt image and its review. Staff key in shop / receipt no. / date / amount (OCR later).
model Receipt {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @default(dbgenerated("gp_next_code('GP'::text, 'receipt_code_seq'::regclass)"))
  submissionId String        @map("submission_id") @db.Uuid
  /// Position in its submission (1 = first file).
  sequence     Int
  memberId     String        @map("member_id") @db.Uuid
  status       ReceiptStatus @default(PENDING_REVIEW)
  submittedAt  DateTime      @default(now()) @map("submitted_at")

  /// Stored file, relative to RECEIPT_STORAGE_DIR. Served only through the API.
  imagePath   String @map("image_path")
  imageMime   String @map("image_mime")
  imageSize   Int    @map("image_size")
  /// SHA-256 of the file bytes: finds re-sent identical images.
  imageSha256 String @map("image_sha256")

  // Typed by staff while reviewing.
  locationId  String?   @map("location_id") @db.Uuid
  shopId      String?   @map("shop_id") @db.Uuid
  receiptNo   String?   @map("receipt_no")
  receiptDate DateTime? @map("receipt_date") @db.Date
  amount      Decimal?  @db.Decimal(12, 2)
  /// shop + normalised receipt no. + date + amount; set on approval, unique among approved receipts.
  fingerprint String?
  /// หมายเหตุ from staff (internal).
  staffNote   String?   @map("staff_note")

  rejectReason RejectReason? @map("reject_reason")
  /// Required for OTHER; internal, never shown to the member.
  rejectNote   String?       @map("reject_note")
  reviewedById String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?     @map("reviewed_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  submission  Submission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shop        Shop?             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  reviewedBy  User?             @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  transaction PointTransaction?

  @@index([status, submittedAt])
  @@index([submissionId])
  @@index([memberId])
  @@index([locationId])
  @@index([shopId])
  @@index([imageSha256])
  @@index([fingerprint])
  @@map("receipts")
}

/// The points one approved receipt earns (at most one per receipt), with the exact rule used.
/// transferStatus tracks sending them to LOGA (Session 6), separately from the receipt status.
model PointTransaction {
  id             String         @id @default(uuid()) @db.Uuid
  receiptId      String         @unique @map("receipt_id") @db.Uuid
  memberId       String         @map("member_id") @db.Uuid
  points         Int
  amount         Decimal        @db.Decimal(12, 2)
  ruleId         String         @map("rule_id") @db.Uuid
  ruleVersion    Int            @map("rule_version")
  /// Snapshot: level, place, spendAmount, points, rounding, maxPoints, claimDays.
  rule           Json
  /// Snapshot: exact (before rounding) and capped.
  calculation    Json
  /// Stable reference sent to LOGA so a retry can never add the points twice.
  reference      String         @unique
  transferStatus TransferStatus @default(PENDING) @map("transfer_status")
  /// Text the member sees in LOGA, fixed at the first send (from the remark template).
  remark         String?
  /// Sends tried so far, and when the next automatic try is due (null = none planned).
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?      @map("last_attempt_at")
  nextAttemptAt  DateTime?      @map("next_attempt_at")
  /// Why the last send didn't succeed (shown to staff; no secrets).
  lastError      String?        @map("last_error")
  sentAt         DateTime?      @map("sent_at")
  /// Member's LOGA balance right after the points were added, if LOGA said.
  pointsAfter    Int?           @map("points_after")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  receipt          Receipt                @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  member           Member                 @relation(fields: [memberId], references: [id], onDelete: Restrict)
  pointRule        PointRule              @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  createdBy        User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transferAttempts PointTransferAttempt[]

  @@index([memberId])
  @@index([transferStatus, nextAttemptAt])
  @@map("point_transactions")
}

/// Every try at sending a point transaction to LOGA (automatic or a staff retry).
model PointTransferAttempt {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  attempt       Int
  result        TransferStatus
  error         String?
  durationMs    Int            @map("duration_ms")
  /// Staff member who pressed "retry"; null = automatic.
  triggeredById String?        @map("triggered_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")

  transaction PointTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  triggeredBy User?            @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@map("point_transfer_attempts")
}

// ---------- Settings ----------

/// One row per Settings page item (see packages/shared/src/settings.ts); missing = default.
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

// ---------- Staff users, roles and permissions ----------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable identifier. System roles: ADMIN, STAFF, COMMUNITY_MANAGER.
  key         String   @unique
  name        String
  description String?
  /// System roles cannot be deleted; ADMIN permissions cannot be reduced.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

/// View/manage grant for one CMS menu (see packages/shared/src/permissions.ts for menu keys).
model RolePermission {
  roleId    String  @map("role_id") @db.Uuid
  menu      String
  canView   Boolean @default(false) @map("can_view")
  canManage Boolean @default(false) @map("can_manage")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menu])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  name               String
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  roleId             String     @map("role_id") @db.Uuid
  /// true = may access every Community/Location (ทุกสถานที่).
  scopeAll           Boolean    @default(false) @map("scope_all")
  /// Set after an admin reset; the user must choose a new password at next login.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  role             Role                   @relation(fields: [roleId], references: [id])
  scopes           UserScope[]
  sessions         AuthSession[]
  resetTokens      PasswordResetToken[]
  auditLogs        AuditLog[]
  members          Member[]
  pointRules       PointRule[]
  ruleChanges      PointRuleVersion[]
  reviewedReceipts Receipt[]
  transferRetries  PointTransferAttempt[]
  settingsChanged  Setting[]
  addedSubmissions Submission[]
  approvedPoints   PointTransaction[]

  @@index([roleId])
  @@map("users")
}

/// One row grants access to a whole Community or to a single Location (exactly one is set).
model UserScope {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  communityId String? @map("community_id") @db.Uuid
  locationId  String? @map("location_id") @db.Uuid

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id])
  location  Location?  @relation(fields: [locationId], references: [id])

  @@unique([userId, communityId, locationId])
  @@index([userId])
  @@map("user_scopes")
}

/// Refresh-token session. Only a SHA-256 hash of the token is stored.
model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  rememberMe Boolean   @default(false) @map("remember_me")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Email "forgot password" token. Only a SHA-256 hash is stored; single use.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Audit ----------

/// Who did what. metadata must never contain passwords, tokens or secrets.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
