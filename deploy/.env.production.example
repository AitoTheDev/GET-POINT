# Copy to deploy/.env.production and fill in. Never commit the filled-in file.
# Used by docker-compose.prod.yml (both for ${...} values in the compose file and as the API's env).

# ---- Database (container "db") ----
POSTGRES_USER=getpoint
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=getpoint

# ---- Ports on the host ----
# Put an HTTPS reverse proxy (or load balancer) in front of these. LINE requires HTTPS for LIFF,
# and staff login cookies are "Secure" in production.
CMS_PORT=8080
LIFF_PORT=8081

# ---- API ----
NODE_ENV=production
PORT=3000
# Public addresses of the two apps (the API allows browser calls only from these).
CORS_ORIGINS=https://cms.example.com,https://liff.example.com
# Public CMS address, used in password-reset emails.
CMS_URL=https://cms.example.com
# Proxies in front of the API: nginx in the app container = 1, plus 1 for an HTTPS proxy/load
# balancer in front of that.
TRUST_PROXY=2

# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL_MINUTES=15
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# ---- Email (password reset). Without SMTP in production, no email is sent. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GET POINT <no-reply@example.com>

# ---- LOGA (must be live in production) ----
LOGA_MODE=live
LOGA_BASE_URL=https://loga.app/api
LOGA_USERNAME=
LOGA_PASSWORD=
LOGA_DEVICE_ID=GETPOINT-API
# The real GET POINT card (not the developer test card).
LOGA_CARD_ID=
LOGA_TIMEOUT_MS=10000

# ---- LINE (must be live in production) ----
LINE_MODE=live
LINE_CHANNEL_ID=
LIFF_ID=
LIFF_SESSION_MINUTES=120

# ---- SMS for phone codes (only if switched on in Settings). Only "mock" exists so far, ----
# ---- which does not send in production: keep the Settings switch off until a provider is added. ----
SMS_PROVIDER=mock

# ---- First admin (used once by the seed command in deploy/README.md) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME
